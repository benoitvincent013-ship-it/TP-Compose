# =============================================================================
# TP COMPOSE — modèle de configuration
#
# Utilisation :
#   cp .env.example .env
#
# Ces valeurs sont FACTICES : ce ne sont pas de vrais secrets.
# Le fichier .env n'est jamais envoyé sur GitHub (voir .gitignore).
# =============================================================================

# Le port ouvert sur votre machine pour voir le site.
# Dans le navigateur : http://localhost:8080
FRONT_PORT=8080

# Le mot de passe de la base Redis.
# Il est factice : il sert uniquement à montrer comment on transmet un mot de
# passe par une variable d'environnement, sans l'écrire dans le code.
REDIS_PASSWORD=mot_de_passe_factice
